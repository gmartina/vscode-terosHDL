{
  "fileTypes": [
    "pro"
  ],
  "scopeName": "source.pro",
  "name": "PRO",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#pro-commands"
    },
    {
      "include": "#tcl-keywords"
    },
    {
      "include": "#tcl-commands"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pro",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pro",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pro",
              "match": "\\\\."
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.global.pro",
          "match": "\\$::[a-zA-Z_][a-zA-Z0-9_:]*"
        },
        {
          "name": "variable.other.bracket.pro",
          "match": "\\$\\{[^}]+\\}"
        },
        {
          "name": "variable.other.pro",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "pro-commands": {
      "patterns": [
        {
          "name": "storage.type.pro",
          "match": "\\b(build|include|library|analyze|simulate|RunTest|SkipTest|TestCase|TestSuite)\\b"
        },
        {
          "name": "support.function.pro.settings",
          "match": "\\b(SetTranscriptType|CreateDirectory|ChangeWorkingDirectory|GetVHDLVersion|SetVHDLVersion)\\b"
        },
        {
          "name": "support.function.pro.library",
          "match": "\\b(LinkLibrary|LinkLibraryDirectory|SetLibraryDirectory|GetLibraryDirectory|MapLibraries|MapAllLibraries|UnmapLibraries)\\b"
        },
        {
          "name": "support.function.pro.simulation",
          "match": "\\b(SetSimulatorResolution|GetSimulatorResolution|SetSecondSimulationTopLevel|SetCoverageSimulateEnable|SetCoverageSimulateOptions|SetCoverageAnalyzeEnable|SetCoverageAnalyzeOptions|GetCoverageSimulateOptions)\\b"
        },
        {
          "name": "support.function.pro.report",
          "match": "\\b(ReportBuildStatus|ReportBuildYaml|CreateBuildReports|OpenBuildHtml|OpenSimulationReportFile|CloseBuildHtml|Report2Html|Report2Junit|Report2Csv|Simulate2Html)\\b"
        },
        {
          "name": "support.function.pro.vendor",
          "match": "\\b(SetVhdlAnalyzeOptions|SetVerilogAnalyzeOptions|SetSimulatorScriptRecordSeparator|SetExtendedAnalyzeOptions|SetExtendedSimulateOptions|SetExtendedRunOptions|SetSaveWaves|SetInteractiveMode|SetDebugMode|SetLogSignals)\\b"
        },
        {
          "name": "support.function.pro.project",
          "match": "\\b(StartBuild|StartBuildYaml|EndBuild|EndSimulation|StartTranscript|StopTranscript|SetBuildName|GetBuildName)\\b"
        },
        {
          "name": "support.function.pro.testbench",
          "match": "\\b(TestName|SetTestName|Log|Alert|AlertIf|AlertIfNot|AlertIfEqual|AlertIfNotEqual|AffirmIf|AffirmIfNot|AffirmIfEqual|AffirmIfNotEqual|GetAlertCount|GetAffirmCount|ReportAlerts|ClearAlerts)\\b"
        },
        {
          "name": "support.function.pro.coverage",
          "match": "\\b(NewCoverage|AddCross|AddBins|ICover|GetCov|WriteCovDb|ReadCovDb|WriteCovHtml|WriteCovYaml|SetCovTarget|GetCovTarget|IsCovered)\\b"
        },
        {
          "name": "support.function.pro.scoreboard",
          "match": "\\b(NewScoreboard|Push|Pop|Check|Empty|GetItemCount|GetPushCount|GetPopCount|GetCheckCount|GetDropCount|SetFinish|GetFinish|WriteScoreboardYaml|GetErrorCount)\\b"
        },
        {
          "name": "support.function.pro.randomization",
          "match": "\\b(RandInt|RandReal|RandSlv|RandUnsigned|RandSigned|RandTime|SetSeed|GetSeed|InitSeed|Uniform|FavorSmall|FavorBig|Normal|Poisson)\\b"
        },
        {
          "name": "support.function.pro.memory",
          "match": "\\b(NewMemory|MemInit|MemRead|MemWrite|MemErase|FileReadH|FileReadB|FileWriteH|FileWriteB|SetMemoryOptions|GetMemoryOptions)\\b"
        }
      ]
    },
    "tcl-keywords": {
      "patterns": [
        {
          "name": "keyword.control.pro",
          "match": "\\b(if|then|else|elseif|for|foreach|while|switch|case|default|break|continue|return|proc|namespace|package|source|catch|try|finally|throw|error|ne|eq)\\b"
        }
      ]
    },
    "tcl-commands": {
      "patterns": [
        {
          "name": "support.function.pro",
          "match": "\\b(set|unset|expr|list|lindex|llength|lappend|linsert|lreplace|lsort|lsearch|lrange|split|join|string|format|scan|regexp|regsub|subst|eval|uplevel|upvar|global|variable|array|dict|file|glob|pwd|cd|open|close|read|gets|puts|flush|eof|fblocked|fconfigure|fcopy|seek|tell|info|trace|rename|interp|load|exit|after|vwait|update|clock|compare)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pro",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.pro",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.pro",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.pro",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.pro",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.pro",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.pro",
          "match": "(&|\\||\\^|~|<<|>>)"
        }
      ]
    }
  }
}
